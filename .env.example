# Copy to .env. One file at the root; every package reads this one.
DATABASE_URL=postgres://lendit:lendit@localhost:5433/lendit
REDIS_URL=redis://localhost:6380
# authSource=admin: the root user from MONGO_INITDB_ROOT_* lives in the admin db.
MONGO_URL=mongodb://lendit:lendit@localhost:27018/lendit?authSource=admin
API_PORT=3000
WEB_PORT=5173
